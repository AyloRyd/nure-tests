{
  "manifest_version": 3,
  "name": "NURETests",
  "version": "1.0.0",
  "description": "Parses questions on dl.nure.ua Moodle test pages",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["*://dl.nure.ua/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "NURETests",
    "default_icon": {
      "32": "favicon.png"
    }
  },
  "icons": {
    "128": "favicon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://dl.nure.ua/mod/quiz/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
